PORT=5000
CLIENT_URL=http://localhost:5173

# Path to the Firebase service account JSON (relative to /server)
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Optional: only allow sign-ups from this email domain, e.g. myuniversity.edu
ALLOWED_EMAIL_DOMAIN=

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@unibike.edu
ADMIN_PASSWORD=admin123
